# ================================================================
# PICKSOME OPS TOOL — 환경변수 예시
# 복사: cp .env.example .env  → 실제 값으로 채울 것
# .env 는 절대 Git 에 커밋하지 않는다.
# ================================================================

# ===== PostgreSQL =====
POSTGRES_USER=picksome
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=picksome_ops

# ===== Backend =====
APP_ENV=prod
JWT_SECRET=change-me-min-32-bytes-random-string-here
JWT_EXPIRE_MINUTES=720
LOG_LEVEL=INFO
SETTLEMENT_REOPEN_LIMIT_DEFAULT=3

# ===== SMTP (알림 이메일) =====
# SMTP_HOST 미설정 시 이메일 알림 비활성
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=PICKSOME OPS <noreply@picksome.co.kr>

# ===== Feature Flags =====
# MVP: 아래 모두 false 유지
FEATURE_EXTERNAL_ACCOUNTANT=false
FEATURE_NOTIFICATION_KAKAO=false
FEATURE_NOTIFICATION_SLACK=false
FEATURE_NOTIFICATION_TELEGRAM=false
FEATURE_NOTIFICATION_WEBHOOK=false

# ===== Proxy / 도메인 =====
APP_HOST=localhost
# 외부 도메인 사용 시: APP_HOST=ops.picksome.co.kr

# ===== 로컬 개발: 초기 admin 시드 비밀번호 (선택) =====
# 미설정 시 `python -m scripts.internal.picksome_init` 실행할 때 랜덤 생성 후 콘솔에 1회만 출력됨.
# docs/34_local_dev_setup_no_docker.md 참고. 평문을 이 파일(.env)에도 커밋 금지.
ADMIN_SEED_PASSWORD=

# ===== 모니터링 (선택) =====
# Sentry DSN — 설정 시 에러 자동 캡처 (PII scrub 규칙 필수 설정)
SENTRY_DSN=
