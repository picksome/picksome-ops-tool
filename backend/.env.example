APP_ENV=dev
APP_TIMEZONE=Asia/Seoul
APP_CURRENCY=KRW

DATABASE_URL=postgresql+psycopg://picksome:picksome@localhost:5432/picksome

JWT_SECRET=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@picksome.local

FEATURE_EXTERNAL_ACCOUNTANT=false
FEATURE_NOTIFICATION_KAKAO=false
FEATURE_NOTIFICATION_SLACK=false
FEATURE_NOTIFICATION_TELEGRAM=false
FEATURE_NOTIFICATION_WEBHOOK=false

SETTLEMENT_REOPEN_LIMIT_DEFAULT=3

# ── 증빙 파일 저장 루트 (M027) ──
# 백업 대상이다. DB 만 백업하면 첨부 행은 있는데 파일이 없는 상태가 된다.
EXPENSE_ATTACHMENT_ROOT=./var/attachments

# ── Worker (M030 / Phase 37) ──
# 애플리케이션 안에 스케줄러를 두지 않는다. 외부 cron / systemd timer 가
# 아래 명령을 주기적으로 부른다 (docs/49_worker_operations_runbook.md).
#
#   python -m app.scripts.run_workers --once --trigger SCHEDULED
#
# 켜지 않으면 화면은 정상으로 보이지만 승인이 반영되지 않고
# 운영 이슈가 갱신되지 않는다.

# ── 자격증명 암호화 (M042, core/secret_store.py) ────────────────────
#
# 무인 동기화를 하려면 프로그램이 API 인증정보를 다시 쓸 수 있어야 한다.
# 암호문은 DB(credential_secret)에, 키는 여기에 둔다.
#
#   ⚠️ DB 백업과 이 키를 같은 번들에 넣으면 분리가 무의미해진다 — docs/60
#
# 키가 없으면 자격증명 기능이 503 CREDENTIAL_STORE_NOT_CONFIGURED 로 거부된다.
# 평문으로 대신 저장하는 fallback 은 없다.
#
# 새 키 만들기:
#   python -c "from app.core.secret_store import generate_master_key as g; print(g())"
CREDENTIAL_STORE_BACKEND=local
CREDENTIAL_MASTER_KEY=
# 키를 교체했다면 옛 키를 쉼표로 남긴다. 남기지 않으면 기존 암호문을 못 읽는다.
CREDENTIAL_RETIRED_KEYS=
